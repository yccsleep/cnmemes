---
import { webpSrc } from '../utils/image';

interface Props {
  slug: string;
  chinese_name: string;
  english_name: string;
  pinyin?: string;
  year: number;
  status: string;
  tags: string[];
  popularity: number;
  image: string;
}

const { slug, chinese_name, english_name, pinyin = '', year, status, tags, popularity, image } = Astro.props;

const statusClass = status === 'still popular' ? 'popular' : status === 'fading' ? 'fading' : 'classic';
const stars = '★'.repeat(popularity) + '☆'.repeat(5 - popularity);
const webp = webpSrc(image);
const searchText = `${chinese_name} ${english_name} ${pinyin} ${tags.join(' ')}`;
---

<a href={`/image-meme/${slug}`} class="im-card" data-search={searchText}>
  <picture>
    {webp && <source srcset={webp} type="image/webp" />}
    <img
      src={image}
      alt={`${chinese_name} — ${english_name} Chinese internet meme`}
      loading="lazy"
      class="im-bg-img"
      width="600"
      height="400"
    />
  </picture>
  <div class="im-overlay"></div>
  <div class="im-content">
    <div class="im-cn">{chinese_name}</div>
    <div class="im-en">{english_name}</div>
    <div class="im-meta">
      <span class="im-tag im-tag-year">{year}</span>
      <span class={`im-tag im-tag-${statusClass}`}>{status}</span>
      {tags.slice(0, 1).map(t => <span class="im-tag im-tag-topic">{t}</span>)}
      <span class="im-stars">{stars}</span>
    </div>
  </div>
</a>

<style>
.im-card {
  position: relative;
  display: block;
  aspect-ratio: 3 / 2;
  border-radius: var(--radius-lg);
  overflow: hidden;
  text-decoration: none;
  border: 1.5px solid var(--border);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.im-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 28px rgba(0,0,0,0.2);
  text-decoration: none;
}

.im-bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.35s ease;
}
.im-card:hover .im-bg-img { transform: scale(1.06); }

.im-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    transparent 25%,
    rgba(0,0,0,0.25) 55%,
    rgba(0,0,0,0.85) 100%
  );
}

.im-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px 14px;
}

.im-cn {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 2px;
  text-shadow: 0 2px 8px rgba(0,0,0,0.6);
}

.im-en {
  font-size: 11px;
  font-weight: 600;
  color: rgba(255,255,255,0.82);
  margin-bottom: 7px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 1px 3px rgba(0,0,0,0.4);
}

.im-meta {
  display: flex;
  align-items: center;
  gap: 5px;
  flex-wrap: nowrap;
  overflow: hidden;
}

.im-tag {
  font-size: 10px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 50px;
  white-space: nowrap;
  backdrop-filter: blur(4px);
  flex-shrink: 0;
}

.im-tag-year    { background: rgba(194,59,34,0.55); color: #fff; }
.im-tag-popular { background: rgba(34,139,34,0.5);  color: #fff; }
.im-tag-classic { background: rgba(100,80,180,0.5); color: #fff; }
.im-tag-fading  { background: rgba(180,130,20,0.5); color: #fff; }
.im-tag-topic   { background: rgba(255,255,255,0.18); color: rgba(255,255,255,0.88); }

.im-stars {
  font-size: 11px;
  color: #f0c040;
  letter-spacing: 0.5px;
  margin-left: auto;
  flex-shrink: 0;
  text-shadow: 0 1px 3px rgba(0,0,0,0.4);
}

@media (max-width: 768px) {
  .im-cn { font-size: 15px; }
}
</style>
